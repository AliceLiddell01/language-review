{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language-review.invalid/schemas/eval-corpus-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "version",
    "annotation_version",
    "split_policy",
    "documents",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "language-review.corpus"
    },
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "annotation_version": {
      "type": "string",
      "minLength": 1
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "test_frozen",
        "test_sha256",
        "holdout_policy"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "test_frozen": {
          "type": "boolean"
        },
        "test_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "holdout_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "path",
          "revision",
          "origin",
          "rights",
          "data_kind",
          "content_base64",
          "sha256",
          "encoding",
          "bom"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "use",
              "publish",
              "basis"
            ],
            "properties": {
              "use": {
                "enum": [
                  "permitted"
                ]
              },
              "publish": {
                "enum": [
                  "permitted",
                  "private_only"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "data_kind": {
            "enum": [
              "synthetic",
              "real"
            ]
          },
          "content_base64": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "encoding": {
            "enum": [
              "utf-8",
              "utf-16-le",
              "utf-16-be",
              "utf-32-le",
              "utf-32-be",
              "windows-1251"
            ]
          },
          "bom": {
            "enum": [
              null,
              "utf-8",
              "utf-16-le",
              "utf-16-be",
              "utf-32-le",
              "utf-32-be"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_url",
              "source_revision",
              "source_sha256",
              "license",
              "license_url",
              "license_sha256",
              "attribution",
              "upstream_split",
              "transformation"
            ],
            "properties": {
              "source_url": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{40}$"
              },
              "source_sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "license": {
                "enum": [
                  "MIT",
                  "MIT-card/Apache-2.0-script",
                  "BSD-3-Clause"
                ]
              },
              "license_url": {
                "type": "string",
                "minLength": 1
              },
              "license_sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
              "upstream_split": {
                "enum": [
                  "dev",
                  "validation",
                  "test"
                ]
              },
              "transformation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "document",
          "split",
          "range",
          "context",
          "profile",
          "languages",
          "categories",
          "terms",
          "exceptions",
          "protected_ranges",
          "applicable",
          "exhaustive",
          "verdict",
          "annotation",
          "labels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "dev",
              "validation",
              "test"
            ]
          },
          "range": {
            "$ref": "#/$defs/range"
          },
          "context": {
            "enum": [
              "documentation",
              "comment",
              "message",
              "log",
              "other"
            ]
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "categories": {
            "type": "array",
            "items": {
              "enum": [
                "spelling",
                "grammar",
                "punctuation",
                "style",
                "bureaucratese",
                "terminology",
                "untranslated_english",
                "typography",
                "other"
              ]
            },
            "uniqueItems": true
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "protected_ranges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/range"
            }
          },
          "applicable": {
            "type": "boolean"
          },
          "exhaustive": {
            "type": "boolean"
          },
          "verdict": {
            "enum": [
              "errors",
              "clean",
              "disputed"
            ]
          },
          "annotation": {
            "$ref": "#/$defs/annotation"
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/label"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_offset",
        "line",
        "column",
        "utf16_column"
      ],
      "properties": {
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "utf16_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "actor",
        "method",
        "evidence",
        "history"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "independently_verified",
            "disputed"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "human",
            "external_reference",
            "model",
            "pipeline",
            "synthetic_contract"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "actor",
              "decision"
            ],
            "properties": {
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "anchors",
        "context",
        "corrections",
        "annotation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "spelling",
            "grammar",
            "punctuation",
            "style",
            "bureaucratese",
            "terminology",
            "untranslated_english",
            "typography",
            "other"
          ]
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "range",
              "text"
            ],
            "properties": {
              "range": {
                "$ref": "#/$defs/range"
              },
              "text": {
                "type": "string"
              }
            }
          },
          "uniqueItems": true
        },
        "annotation": {
          "$ref": "#/$defs/annotation"
        }
      }
    }
  }
}
